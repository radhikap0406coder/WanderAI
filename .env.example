# =============================================================================
# WanderAI Environment Configuration
# Copy this file to backend/.env and update values as needed.
# =============================================================================

# Google Gemini API Key (Recommended for live AI planning and chat)
# Get a free key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Server Network Settings
HOST=127.0.0.1
PORT=8000

# Authentication & Security
# Change this secret key in production (minimum 32 characters)
JWT_SECRET_KEY=wanderai-super-secret-jwt-key-2026-production-grade-at-least-32-bytes
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Allowed CORS Origins (Comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5500,http://127.0.0.1:5500,http://localhost:8000,http://127.0.0.1:8000

